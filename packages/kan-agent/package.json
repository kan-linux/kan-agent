{
	"name": "@kan-linux/kan-agent",
	"version": "0.0.3",
	"private": true,
	"description": "Kan-Agent: customized Pi tool layer, permission layer, and llama-server binding",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"config"
	],
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc --noEmit"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "1.6.0",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@types/node": "22.19.19"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
